MAILDEBUG_ENV=development

MAILDEBUG_SMTP_PORT=1025
MAILDEBUG_USERNAME=username
MAILDEBUG_PASSWORD=password

MAILDEBUG_API_PORT=8100
MAILDEBUG_DB_NAME=mail.bolt

MAILDEBUG_DOMAIN=localhost
MAILDEBUG_READ_TIMEOUT=10
MAILDEBUG_WRITE_TIMEOUT=10
# 25 MiB — matches what most providers accept, so mail that would go out in
# production isn't rejected here. Advertised to senders via the SIZE extension.
MAILDEBUG_MAX_MESSAGE_BYTES=26214400
MAILDEBUG_MAX_RECIPIENTS=50
# Max length of a single SMTP input line. React Email and friends emit HTML
# unwrapped, so one line can be tens of thousands of chars. 0 = unlimited.
MAILDEBUG_MAX_LINE_LENGTH=1048576
MAILDEBUG_ALLOW_INSECURE_AUTH=true

# Optional: host:port of a SpamAssassin spamd daemon for the spam-score check.
# Leave empty to disable the /messages/:id/spam-check endpoint.
MAILDEBUG_SPAMASSASSIN=
